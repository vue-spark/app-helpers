{
  "name": "@vue-spark/app-helpers",
  "type": "module",
  "version": "0.6.0",
  "packageManager": "pnpm@12.8.1",
  "description": "Lightweight Helpers for Vue 3 Application Development.",
  "author": "leiwang <leiwang2000@foxmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/vue-spark/app-helpers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vue-spark/app-helpers.git"
  },
  "bugs": "https://github.com/vue-spark/app-helpers/issues",
  "keywords": [
    "vue",
    "app",
    "helpers",
    "permission",
    "sso"
  ],
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./permission": "./dist/permission/index.mjs",
    "./sso": "./dist/sso/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "prepack": "nr build",
    "release": "bumpp",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills experimental_sync -y -a universal"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "knip": "Find unused files, exports and dependencies",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "ci": "Run the full continuous integration pipeline",
    "prepare": "Set up git hooks and skills"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "happy-dom": "catalog:dev",
    "knip": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills": "catalog:agentic",
    "taze": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vue": "catalog:dev",
    "vue-router": "catalog:dev"
  },
  "skills": [
    {
      "source": "mattpocock/skills/skills/productivity",
      "skills": [
        "writing-for-agents"
      ]
    },
    {
      "source": "antfu/skills",
      "skills": [
        "antfu"
      ]
    },
    {
      "source": "ericlitman/open-pstack/plugins/pstack/skills",
      "skills": [
        "unslop"
      ]
    }
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  },
  "inlinedDependencies": {
    "@antfu/utils": "9.3.0"
  }
}
